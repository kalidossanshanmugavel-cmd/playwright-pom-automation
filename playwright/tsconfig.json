
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "paths": {
      "@pages/*": ["./tests/pages/*"],
      "@utils/*": ["./tests/utils/*"],
      "@data/*": ["./tests/data/*"]
    },

    "types": [
      "node",
      "@playwright/test"
    ],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },

  "include": [
    "tests/**/*.ts",
    "playwright.config.ts"
  ],

  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}
